# Copy to .env and keep .env out of git.
# Use an Hyperliquid *agent* wallet key, not your seed phrase.

MODE=paper
CONFIRM_LIVE=
HL_NETWORK=testnet
HL_AGENT_KEY=
HL_ACCOUNT_ADDRESS=
COIN=BTC
MAX_NOTIONAL_USD=50
MAX_LEVERAGE=2
POLL_SECONDS=30
SLIPPAGE=0.01

# Public address only (safe to also put in docs/config.js) for the Pages dashboard
PUBLIC_ACCOUNT_ADDRESS=
